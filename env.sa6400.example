# AIHOT 配置模板 —— 群晖 SA6400 部署用（复制成 .env 后填写）
#
# 用法：cp env.sa6400.example .env  然后按下面注释填写
# 只有标了【必填】的必须动，其余可先不管，遇到问题再回来调。

# ===== 镜像来源（用 docker-compose.hub.yml 时必填）=====
# 【必填】你的 Docker Hub 用户名 + 镜像名，必须和 GitHub Actions 里推送的一致
AIHOT_IMAGE=你的DockerHub用户名/aihot-app:latest

# ===== 必填：站点与安全 =====
# 宿主端口。群晖上 3000 已被占用，改成任意空闲端口（先查：sudo netstat -tln | grep :3100）
PORT=3100

# 网站对外地址。RSS、分享图、MCP 里的链接全用它，不会随浏览器地址变化。
# 注意端口要和上面的 PORT 一致
SITE_URL=http://192.168.1.10:3100

# 后台 /admin 的登录密码，至少 12 位
ADMIN_PASSWORD=

# 随机密钥，生成方法：openssl rand -hex 32   （三个各跑一次）
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=

# 数据库密码，同上随机生成。数据库不对外开端口，用随机字符即可
POSTGRES_PASSWORD=

# ===== 必填：模型 =====
# 任何 OpenAI 兼容接口都行。下面三组任选一组，填对应的一组即可。

# 方案 A：阿里云百炼（推荐，已实测 2026-10-05 可用）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.7-plus
LLM_EXTRA_JSON={"enable_thinking":false}

# 方案 B：DeepSeek（最便宜，注意峰时价格翻倍）
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-flash
# LLM_EXTRA_JSON={"thinking":{"type":"disabled"}}

# 方案 C：智谱
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=
# LLM_MODEL=glm-5.3-flash

# ===== 必填：安全阀（不打开什么都不跑）=====
COLLECT_ENABLED=true
MODEL_CALLS_ENABLED=true

# ===== 选填：群晖上推荐调整 =====
# 用 DSM 自带反向代理做 HTTPS 时改成下面三行，并把反向代理指向 http://127.0.0.1:3100
# PORT=127.0.0.1:3100
# TRUST_PROXY=true
# SITE_URL=https://你的域名

# 部署目录提醒：本机 Docker 目录是 /volume2/docker，所以本项目放在
# /volume2/docker/aihot/，所有 docker compose 命令都要先 cd 到那里。
# 记得把 /volume1/docker 从「索引服务」里排除，避免 PostgreSQL 数据目录被反复索引。

# 事件归组更准（强烈建议配，否则热度会偏低）。只填百炼 key 最省事：
# DASHSCOPE_API_KEY=
# 或用 OpenAI 兼容的向量接口：
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small

# 付费采集（默认关闭，按请求计费，后台有预算熔断）
# SOCIALDATA_API_KEY=        # X 账号
# DAJIALA_KEY=              # 微信公众号
# JINA_API_KEY=              # 正文抓取兜底

# 服务器在中国大陆、抓不到海外信源时才需要（只代理抓取，不走模型）
# EGRESS_PROXY_URL=http://代理地址:端口

# 数据库每天自动备份到 S3 兼容对象存储（腾讯云 COS / AWS S3 / 阿里云 OSS）
# 强烈建议配上，否则数据库只有本地一份
# DB_BACKUP_STORE_SECRET_ID=
# DB_BACKUP_STORE_SECRET_KEY=
# DB_BACKUP_STORE_BUCKET=
# DB_BACKUP_STORE_REGION=
